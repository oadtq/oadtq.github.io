---
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/700.css';
import '../styles/themes.css';
import '../styles/global.css';
import { DEFAULT_THEME, SITE, THEMES, THEME_STORAGE_KEY } from '../consts';

const themeIds = THEMES.map((t) => t.id);

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
}

const { title, description = SITE.tagline, type = 'website' } = Astro.props;
const fullTitle = title === SITE.name ? `${title} — ${SITE.tagline}` : `${title} — ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Notes`} href="/rss.xml" />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{fullTitle}</title>
    {/* applied before first paint so the chosen theme never flashes */}
    <script
      is:inline
      define:vars={{ themeIds, defaultTheme: DEFAULT_THEME, storageKey: THEME_STORAGE_KEY }}
    >
      try {
        const stored = localStorage.getItem(storageKey);
        document.documentElement.dataset.theme = themeIds.includes(stored) ? stored : defaultTheme;
      } catch {
        document.documentElement.dataset.theme = defaultTheme;
      }
    </script>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
