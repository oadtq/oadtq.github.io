---
import Base from '../layouts/Base.astro';
import SideNav from '../components/SideNav.astro';
import { READING_LIST } from '../consts';

const groups = [...READING_LIST].sort((a, b) => b.date.localeCompare(a.date));

const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`)
    .toLocaleDateString('en-GB', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    })
    .toUpperCase();
---

<Base title="Reading List" description="Articles and videos worth your time, with notes on why.">
  <div class="wrap page-grid">
    <SideNav active="reading-list" />

    <div class="page-main">
      <h1 class="page-title">Reading List</h1>

      <p class="page-lead">Articles and videos I recommend. Updated periodically.</p>

      <section class="page-section">
        {
          groups.map((group) => (
            <section class="reading-group">
              <h2 class="reading-date">
                <time datetime={group.date}>{formatDate(group.date)}</time>
              </h2>

              <ul class="reading-list">
                {group.items.map((item) => (
                  <li>
                    <a href={item.url} target="_blank" rel="noopener" class="leader-row">
                      <span class="label">{item.title}</span>
                      <span class="leader" aria-hidden="true" />
                      <span class="meta">{item.source}</span>
                    </a>
                    <p class="blurb">{item.comment}</p>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </section>
    </div>
  </div>
</Base>
