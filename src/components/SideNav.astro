---
import ThemePicker from './ThemePicker.astro';
import { NAV, type NavItem } from '../consts';

interface Props {
  active?: NavItem['id'];
}

const { active } = Astro.props;
---

<aside class="side">
  <nav class="side-block" aria-label="Primary">
    <ul class="nav-list">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', { active: item.id === active }]}
              aria-current={item.id === active ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="side-block side-theme">
    <ThemePicker />
  </div>
</aside>
