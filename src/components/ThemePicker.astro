---
import { DEFAULT_THEME, THEMES, THEME_STORAGE_KEY } from '../consts';

const defaultLabel = THEMES.find((t) => t.id === DEFAULT_THEME)?.label ?? THEMES[0].label;
---

<div class="theme-picker" data-storage-key={THEME_STORAGE_KEY}>
  <button
    type="button"
    class="theme-toggle"
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls="theme-menu"
  >
    <span class="theme-swatch" data-theme-preview={DEFAULT_THEME} data-theme-current-swatch aria-hidden="true"
    ></span>
    <span class="theme-current" data-theme-label>{defaultLabel}</span>
    <span class="theme-caret" aria-hidden="true">▾</span>
  </button>

  <ul class="theme-menu" id="theme-menu" role="menu" hidden>
    {
      THEMES.map((theme) => (
        <li role="none">
          <button
            type="button"
            class="theme-option"
            role="menuitemradio"
            aria-checked={theme.id === DEFAULT_THEME ? 'true' : 'false'}
            data-theme={theme.id}
            data-label={theme.label}
          >
            <span class="theme-swatch" data-theme-preview={theme.id} aria-hidden="true"></span>
            {theme.label}
          </button>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .theme-picker {
    position: relative;
  }

  /* same visual language as the .chip buttons on the home page */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--muted);
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 7px 10px;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .theme-toggle:hover,
  .theme-toggle[aria-expanded='true'] {
    color: var(--accent);
    border-color: var(--accent);
  }

  .theme-current {
    flex: 1;
  }

  .theme-caret {
    font-size: 0.6rem;
    line-height: 1;
    transition: transform 0.12s ease;
  }

  .theme-toggle[aria-expanded='true'] .theme-caret {
    transform: rotate(180deg);
  }

  .theme-menu {
    position: absolute;
    left: 0;
    top: calc(100% + 6px);
    z-index: 20;
    list-style: none;
    min-width: 100%;
    max-height: min(60vh, 340px);
    overflow-y: auto;
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 4px 0;
  }

  .theme-option {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    font-size: 0.75rem;
    color: var(--muted);
    padding: 6px 10px;
    white-space: nowrap;
    transition: color 0.12s ease, background-color 0.12s ease;
  }

  .theme-option:hover {
    color: var(--accent);
  }

  .theme-option[aria-checked='true'] {
    color: var(--fg);
    font-weight: 500;
  }

  .theme-swatch {
    width: 9px;
    height: 9px;
    flex-shrink: 0;
    border: 1px solid var(--line);
  }

  /* swatch previews are literal theme bg/accent pairs, so they can't
     come from the active theme's variables */
  [data-theme-preview='github-light'] {
    background: linear-gradient(135deg, #ffffff 50%, #0969da 50%);
  }
  [data-theme-preview='github-dark'] {
    background: linear-gradient(135deg, #0d1117 50%, #4493f8 50%);
  }
  [data-theme-preview='one-dark'] {
    background: linear-gradient(135deg, #282c34 50%, #61afef 50%);
  }
  [data-theme-preview='material'] {
    background: linear-gradient(135deg, #263238 50%, #80cbc4 50%);
  }
  [data-theme-preview='gruvbox-dark'] {
    background: linear-gradient(135deg, #282828 50%, #fabd2f 50%);
  }
  [data-theme-preview='gruvbox-light'] {
    background: linear-gradient(135deg, #fbf1c7 50%, #af3a03 50%);
  }
  [data-theme-preview='nord'] {
    background: linear-gradient(135deg, #2e3440 50%, #88c0d0 50%);
  }
  [data-theme-preview='solarized-light'] {
    background: linear-gradient(135deg, #fdf6e3 50%, #268bd2 50%);
  }
  [data-theme-preview='paper'] {
    background: linear-gradient(135deg, #e8e8e8 50%, #3d5660 50%);
  }
  [data-theme-preview='night-owl'] {
    background: linear-gradient(135deg, #011627 50%, #aae87b 50%);
  }
  [data-theme-preview='omaha'] {
    background: linear-gradient(135deg, #ffffff 50%, #00017b 50%);
  }
  [data-theme-preview='crt-mono'] {
    background: linear-gradient(135deg, #090909 50%, #d9d9d9 50%);
  }

  /* the nav collapses into a row at the top of the page here, so the menu
     has to drop down (up would leave the viewport) and hang off the right
     edge of the button, which sits in the right gutter */
  @media (max-width: 1023px) {
    .theme-toggle {
      width: auto;
    }

    .theme-menu {
      left: auto;
      right: 0;
    }
  }
</style>

<script>
  const picker = document.querySelector<HTMLElement>('.theme-picker');

  if (picker) {
    const storageKey = picker.dataset.storageKey ?? 'oadtq-theme';
    const toggle = picker.querySelector<HTMLButtonElement>('.theme-toggle')!;
    const menu = picker.querySelector<HTMLElement>('.theme-menu')!;
    const label = picker.querySelector<HTMLElement>('[data-theme-label]')!;
    const currentSwatch = picker.querySelector<HTMLElement>('[data-theme-current-swatch]')!;
    const options = Array.from(picker.querySelectorAll<HTMLButtonElement>('.theme-option'));

    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };

    const paint = (id: string) => {
      document.documentElement.dataset.theme = id;
      currentSwatch.dataset.themePreview = id;
      for (const option of options) {
        const selected = option.dataset.theme === id;
        option.setAttribute('aria-checked', String(selected));
        if (selected) label.textContent = option.dataset.label ?? id;
      }
    };

    // the inline script in Base.astro already applied the stored theme;
    // this only syncs the button label and checked state
    paint(document.documentElement.dataset.theme ?? options[0].dataset.theme!);

    toggle.addEventListener('click', () => setOpen(menu.hidden));

    for (const option of options) {
      option.addEventListener('click', () => {
        const id = option.dataset.theme!;
        paint(id);
        try {
          localStorage.setItem(storageKey, id);
        } catch {
          /* private mode — theme just won't persist */
        }
        setOpen(false);
        toggle.focus();
      });
    }

    document.addEventListener('click', (event) => {
      if (!menu.hidden && !picker.contains(event.target as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
